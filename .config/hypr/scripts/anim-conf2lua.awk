# Convert a hyprlang animation preset (animations/*.conf) into Lua for UserAnimations.lua
# Usage: awk -f anim-conf2lua.awk preset.conf > UserConfigs/UserAnimations.lua
function trim(s) { gsub(/^[ \t]+|[ \t]+$/, "", s); return s }
function on(v)   { return (v == "1" || v == "yes" || v == "true" || v == "on") ? "true" : "false" }
# Lua config enforces limits the old parser ignored: bezier y in [-1, 2], speed <= 100
function cy(v)   { v = trim(v) + 0; return v < -1 ? -1 : (v > 2 ? 2 : v) }

BEGIN { print "-- Generated by Animations.sh from " ARGV[1] }

{ sub(/#.*/, "") }

/^[ \t]*enabled[ \t]*=/ {
    split($0, kv, "=")
    print "hl.config({ animations = { enabled = " on(trim(kv[2])) " } })"
}

/^[ \t]*bezier[ \t]*=/ {
    sub(/^[^=]*=/, "")
    n = split($0, f, ",")
    printf "hl.curve(\"%s\", { type = \"bezier\", points = { { %s, %s }, { %s, %s } } })\n",
        trim(f[1]), trim(f[2]), cy(f[3]), trim(f[4]), cy(f[5])
}

/^[ \t]*animation[ \t]*=/ {
    sub(/^[^=]*=/, "")
    n = split($0, f, ",")
    line = sprintf("hl.animation({ leaf = \"%s\", enabled = %s", trim(f[1]), on(trim(f[2])))
    if (n >= 3) { sp = trim(f[3]) + 0; line = line sprintf(", speed = %s", sp > 100 ? 100 : trim(f[3])) }
    if (n >= 4) line = line sprintf(", bezier = \"%s\"", trim(f[4]))
    if (n >= 5) {
        style = trim(f[5]); for (i = 6; i <= n; i++) style = style ", " trim(f[i])
        if (style != "") line = line sprintf(", style = \"%s\"", style)
    }
    print line " })"
}
