/* Main rofi theme: Spotlight-style list, translucent over Hyprland blur,
 * rounded and bordered like your windows. Every menu imports this file.
 * Colours come from wallust (wallust/colors-rofi.rasi); the values below are
 * only a fallback when that file is missing. */

@theme "/dev/null"

* {
    font:   "JetbrainsMono Nerd Font 12";

    bg0:    #242424CC;
    bg1:    #7E7E7E40;
    bg2:    #0860f2E6;
    fg0:    #DEDEDE;
    fg1:    #FFFFFF;
    fg2:    #DEDEDE80;
    accent: #0860f2;
    urgent: #E06C75;

    background-color:   transparent;
    text-color:         @fg0;

    margin:     0;
    padding:    0;
    spacing:    0;
}

@import "wallust/colors-rofi.rasi"

configuration {
    modi:                       "drun,run";
    show-icons:                 true;
    icon-theme:                 "breeze-dark";
    display-drun:               "Apps";
    display-run:                "Run";
    display-filebrowser:        "Files";
    display-window:             "Windows";
    display-dmenu:              "";
    drun-display-format:        "{name}";
    hover-select:               true;
    me-select-entry:            "";
    me-accept-entry:            "MousePrimary";
    window-format:              "{w} · {c} · {t}";
}

/* Same look as a Hyprland window: rounding 10, 2px accent border.
 * Translucency shows the blur from the rofi layer rule in WindowRules.lua. */
window {
    location:           center;
    width:              640px;
    transparency:       "real";
    background-color:   @bg0;
    border:             2px;
    border-color:       @accent;
    border-radius:      10px;
}

mainbox {
    padding:    8px;
    spacing:    8px;
    children:   [ inputbar, message, listview ];
}

/* search icon, text box, then the menu name (the -p text, e.g. "Games") as a tag on the right */
inputbar {
    padding:            10px 12px;
    spacing:            10px;
    border-radius:      8px;
    background-color:   @bg1;
    children:           [ icon-search, entry, prompt ];
}

icon-search {
    expand:     false;
    filename:   "search";
    size:       22px;
}

prompt {
    font:       "JetbrainsMono Nerd Font Bold 10";
    text-color: @accent;
}

icon-search, prompt, entry, element-icon, element-text {
    vertical-align: 0.5;
}

entry {
    font:               inherit;
    placeholder:        "Search";
    placeholder-color:  @fg2;
}

message {
    padding:            8px 12px;
    border-radius:      8px;
    background-color:   @bg1;
}

textbox {
    text-color: @fg0;
}

listview {
    lines:          8;
    columns:        1;
    fixed-height:   false;
    scrollbar:      false;
    spacing:        2px;
    cycle:          true;
}

element {
    padding:        8px 12px;
    spacing:        12px;
    border-radius:  8px;
}

/* active = marked rows, e.g. the current audio device */
element normal active, element alternate active {
    text-color: @accent;
}

element normal urgent, element alternate urgent {
    text-color: @urgent;
}

element selected normal, element selected active, element selected urgent {
    background-color:   @bg2;
    text-color:         @fg1;
}

element-icon {
    size:   1.3em;
}

element-text {
    text-color: inherit;
}

scrollbar {
    handle-width:       4px;
    handle-color:       @accent;
    border-radius:      4px;
    background-color:   @bg1;
}
