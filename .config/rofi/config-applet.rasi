/* Applets (power, media, screenshot, brightness): a header line and a row of
 * big icon buttons. Same colours, border, rounding and font as config.rasi.
 * Layout idea from adi1090x/rofi applets (GPL-3.0); written from scratch here.
 * The applet scripts set the number of columns and the window width. */
@import "config.rasi"

window {
    width: 560px;
}

/* no search bar: pick with arrows/Enter, the mouse, or by typing a label */
mainbox {
    padding:    10px;
    spacing:    10px;
    children:   [ message, listview ];
}

message {
    padding:            10px 14px;
    background-color:   @bg1;
}

textbox {
    horizontal-align:   0.5;
}

listview {
    lines:          1;
    columns:        5;
    fixed-columns:  true;
    spacing:        8px;
    cycle:          true;
}

element {
    orientation:        vertical;
    padding:            16px 6px;
    border-radius:      8px;
    background-color:   @bg1;
    children:           [ element-text ];
}

element-text {
    horizontal-align:   0.5;
    vertical-align:     0.5;
}
