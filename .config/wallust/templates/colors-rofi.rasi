/* Generated by wallust from templates/colors-rofi.rasi - do not edit, it is rewritten on every wallpaper change.
 * Keep comments free of a slash-star sequence: rofi does not nest comments. */

* {
    /* used by config.rasi (main launcher and every menu that imports it) */
    bg0:    {{background}}CC;
    bg1:    {{color8}}40;
    bg2:    {{color12}}E6;
    fg0:    {{foreground}};
    fg1:    {{foreground}};
    fg2:    {{foreground}}80;
    accent: {{color12}};
    urgent: {{color13}};

    /* names used by the KooL configs (search, music menu, wallpaper picker)
     * and by ThemeChanger.sh, which rewrites the selected-* lines */
    background:                  {{background}}E6;
    foreground:                  {{foreground}};
    color0:                      {{background}}E6;
    color1:                      {{color8}}80;
    color11:                     {{color12}}E6;
    active-background:           {{color12}};
    selected-normal-background:  {{color12}};
    selected-active-background:  {{color4}};
    selected-urgent-background:  {{color13}};
}
