{
  "_note": "Only Firefox (Pywalfox) reads this: color0/8 are the background shades, 1/2 the accent, 15 the text.",
  "wallpaper": "{{wallpaper}}",
  "alpha": "100",
  "special": {
    "background": "{{background}}",
    "foreground": "#E2E2E6",
    "cursor": "{{cursor}}"
  },
  "colors": {
    "color0": "{{background}}",
    "color1": "{{color12}}",
    "color2": "{{color12 | lighten(0.15)}}",
    "color3": "{{color3}}",
    "color4": "{{color4}}",
    "color5": "{{color5}}",
    "color6": "{{color6}}",
    "color7": "#BDBDC4",
    "color8": "{{background | lighten(0.08)}}",
    "color9": "{{color12}}",
    "color10": "{{color12 | lighten(0.15)}}",
    "color11": "{{color11}}",
    "color12": "{{color12}}",
    "color13": "{{color13}}",
    "color14": "{{color14}}",
    "color15": "#E2E2E6"
  }
}
